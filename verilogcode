module bin_to_bcd(
    input [7:0] binary,           // Binary result from the operation
    output reg [3:0] hundreds,
    output reg [3:0] tens,
    output reg [3:0] ones
);
    always @(*) begin
        hundreds = binary / 100;
        tens = (binary % 100) / 10;
        ones = binary % 10;
    end
endmodule

module bcd_to_7seg(
    input [3:0] bcd,              // BCD digit
    output reg [6:0] seg          // 7-segment display (common cathode)
);
    always @(*) begin
        case (bcd)
           4'b0000: seg = 7'b1000000; // 0
            4'b0001: seg = 7'b1111001; // 1
            4'b0010: seg = 7'b0100100; // 2
            4'b0011: seg = 7'b0110000; // 3
            4'b0100: seg = 7'b0011001; // 4
            4'b0101: seg = 7'b0010010; // 5
            4'b0110: seg = 7'b0000010; // 6
            4'b0111: seg = 7'b1111000; // 7
            4'b1000: seg = 7'b0000000; // 8
            4'b1001: seg = 7'b0010000; // 9
            default: seg = 7'b1111111; //
        endcase
    end
endmodule

module calc(
    input [3:0] num1,             // First 4-bit operand
    input [3:0] num2,             // Second 4-bit operand
    input [1:0] operation,        // Operation: 00 = add, 01 = subtract, 10 = multiply, 11 = divide
    input clk,                    // Clock for multiplexing
    output [6:0] seg_out,         // Segments for the current 7-segment display
    output reg [7:0] anode        // Anode signals for 8-digit display multiplexing
);

    reg [7:0] result;
    reg [15:0] bcd_result;
    wire [3:0] hundreds, tens, ones;
    reg [3:0] digit;
    reg [17:0] clk_div;
    reg [2:0] digit_select;

    // Clock divider for multiplexing
    always @(posedge clk) begin
        clk_div <= clk_div + 1;
    end

    // Arithmetic operation based on operation input
    always @(*) begin
        case (operation)
            2'b00: result = num1 + num2;
            2'b01: result = num1 - num2;
            2'b10: result = num1 * num2;
            2'b11: result = (num2 != 0) ? (num1 / num2) : 8'b00000000;
            default: result = 8'b00000000;
        endcase
    end

    // Binary to BCD conversion for display
    bin_to_bcd converter (
        .binary(result),
        .hundreds(hundreds),
        .tens(tens),
        .ones(ones)
    );

    // Digit select and anode control
    always @(posedge clk_div[17]) begin
        digit_select <= digit_select + 1;
        if (digit_select == 3'b010) // Reset after third digit
            digit_select <= 0;
    end

    always @(*) begin
        case (digit_select)
            3'b000: begin
                digit = ones;           // Display ones place
                anode = 8'b11111110;
            end
            3'b001: begin
                digit = tens;           // Display tens place
                anode = 8'b11111101;
            end
            3'b010: begin
                digit = hundreds;       // Display hundreds place
                anode = 8'b11111011;
            end
            default: begin
                digit = 4'b0000;        // Blank unused digits
                anode = 8'b11111111;
            end
        endcase
    end

    // 7-segment decoding for the selected digit
    bcd_to_7seg decoder (.bcd(digit), .seg(seg_out));

endmodule
